# Everything is optional: `docker compose up` works without a .env file.

# Provider: ollama (default — free, local) | anthropic (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Cheap router + stronger specialists, also on the local provider
OLLAMA_ROUTER_MODEL=llama3.2:3b
OLLAMA_AGENT_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# Only for LLM_PROVIDER=anthropic (and for a Claude judge in the evaluation)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...      # only for organisation-level keys (sk-ant-usr...)
ROUTER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# Docker Compose on a machine with an NVIDIA GPU (';' on Windows, ':' on Linux/macOS)
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# API container talking to an Ollama on the host (e.g. macOS with Metal)
# COMPOSE_OLLAMA_URL=http://host.docker.internal:11434

# Persistence and auth
DB_PATH=var/app.db
# HS256 key, >= 32 chars. Unset = generated once and stored next to DB_PATH (var/jwt-secret).
# AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_S=3600
HANDOFF_TTL_MINUTES=240

# Personality stage (brand voice; an extra LLM call — off by default with local models)
PERSONALITY_ENABLED=false
PERSONALITY_MODEL=claude-haiku-5-5

# Orchestration
ROUTER_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_ITERATIONS=5
WEB_SEARCH_MAX_USES=2
# Web search on the local provider: Brave Search API key (free plan at https://api-dashboard.search.brave.com).
# Unset = DuckDuckGo HTML without a key, which some networks answer with a bot challenge.
# BRAVE_SEARCH_API_KEY=

# RAG: e5 = local multilingual embeddings (default) | hashing = offline lexical fallback
EMBEDDER=e5
RETRIEVAL_TOP_K=6

# Evaluation (npm run eval)
# EVAL_BASE_URL=http://localhost:3000
# JUDGE_PROVIDER=ollama               # or anthropic
# JUDGE_MODEL=qwen2.5:7b              # must be another family than the generator (llama)

PORT=3000
LOG_LEVEL=info

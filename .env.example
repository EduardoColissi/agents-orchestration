# Provider: anthropic (default, needs the key) | ollama (free local model, no key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
# Only if your key is an organisation-level key (sk-ant-usr...): the workspace it should bill to
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Only for LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Models (cheap router, stronger answering agents)
ROUTER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# Personality stage (brand voice on every answer)
PERSONALITY_ENABLED=true
PERSONALITY_MODEL=claude-haiku-5-5

# Orchestration
ROUTER_CONFIDENCE_THRESHOLD=0.6
AGENT_MAX_ITERATIONS=5
WEB_SEARCH_MAX_USES=2

# RAG: e5 = local multilingual embeddings (default) | hashing = offline lexical fallback
EMBEDDER=e5
RETRIEVAL_TOP_K=6
# RETRIEVAL_MIN_SCORE=0.78

PORT=3000
LOG_LEVEL=info
